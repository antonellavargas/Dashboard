# Fuente de datos: local | onedrive
DATA_SOURCE=local

# Para desarrollo local. En producción agrega aquí el dominio exacto de GitHub Pages.
# Ejemplo: https://TU-USUARIO.github.io
CORS_ORIGINS=http://localhost:5173

# Microsoft Entra ID / Microsoft Graph (solo si DATA_SOURCE=onedrive)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=

# Usa SOLO una de estas dos opciones para identificar el Excel:
MS_EXCEL_ITEM_ID=
MS_EXCEL_PATH=Inventario/INVENTARIO GENERAL TI - ACTUAL.xlsx
